{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered customer account profile in Fugo",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address"
        },
        "displayName": {
          "type": "string",
          "description": "Customer display or business name"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Customer primary contact phone"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user creation"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login"
        }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles indexed by Firebase Auth UID"
    }
  }
}
